{
  "name": "net-observation-project",
  "version": "1.0.0",
  "description": "Cyber-neon observability suite with Cloudflare Pages",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:integration && npm run test:ui",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest tests/unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest tests/integration",
    "test:ui": "playwright test",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  }
}