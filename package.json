{
  "name": "net-observation-project",
  "version": "1.0.0",
  "description": "Cyber-neon observability suite",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "docs/**/*.js",
      "functions/**/*.js",
      "!docs/script.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}